---
import Studio from '../layouts/Studio.astro';
import BarreBuild from '../components/BarreBuild.astro';
import CarteVideo from '../components/CarteVideo.astro';
import Crayon from '../components/Crayon.astro';
import { ADRESSE_VIDEOS, lireBuilds, pagesPrevues, type Build } from '../lib/contenu';
import { imageDePartage, visuelDePage } from '../lib/images';

export async function getStaticPaths() {
  const builds = await lireBuilds();
  return builds.map((build) => ({ params: { build: build.slug }, props: { build } }));
}

interface Props {
  build: Build;
}

const { build } = Astro.props;
const prevues = pagesPrevues(build);
const nbVideos = build.videos.length;
const visuel = await visuelDePage(build.visuel);
const partage = await imageDePartage(build.visuel ?? build.image);
---

<Studio
  titre={`${build.nom} · Spriinty’s Studio`}
  description={build.resume || build.type}
  theme={build.couleurs}
  image={partage?.src}
>
  <BarreBuild
    build={build}
    actif=""
    crayon={{ chemin: `collection/builds/item/${build.slug}`, libelle: `Modifier ${build.nom}` }}
  />

  <header class="conteneur tete">
    <div class="tete__gauche">
      {build.type && <p class="surtitre tete__type">{build.type}</p>}
      <h1 class="tete__nom">{build.nom}</h1>
    </div>
    <div class="tete__droite">
      {build.resume && <p class="tete__resume">{build.resume}</p>}
      {
        build.liens.length > 0 && (
          <div class="tete__liens">
            {build.liens.map((lien, i) => (
              <a
                href={lien.url}
                class:list={['bouton', { 'bouton--accent': i === 0 }]}
                target="_blank"
                rel="noopener noreferrer"
              >
                {lien.libelle} ↗
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  {
    visuel && (
      <figure class="conteneur visuel">
        <div class="visuel__cadre">
          <img
            src={visuel.src}
            width={visuel.attributes.width}
            height={visuel.attributes.height}
            alt={`Aperçu de ${build.nom}`}
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption class="visuel__legende">
          Sc. {String(build.numero).padStart(2, '0')} · {build.nom}
        </figcaption>
      </figure>
    )
  }

  {
    (build.sousPages.length > 0 || nbVideos > 0) && (
      <section class="conteneur sommaire" aria-labelledby="sommaire-titre">
        <div class="sommaire__tete">
          <h2 class="surtitre" id="sommaire-titre">
            Dans ce build
          </h2>
          <Crayon chemin={`collection/pages-${build.slug}/create`} libelle="Ajouter une page" />
        </div>
        <ul class="sommaire__liste">
          {build.sousPages.map((page) => (
            <li>
              <a href={`/${build.slug}/${page.slug}`} class="sommaire__lien">
                <span class="sommaire__nom">{page.titre}</span>
                {page.resume && <span class="sommaire__resume">{page.resume}</span>}
                <span class="sommaire__fleche" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          {nbVideos > 0 && (
            <li>
              <a href={`/${build.slug}/${ADRESSE_VIDEOS}`} class="sommaire__lien">
                <span class="sommaire__nom">Vidéos</span>
                <span class="sommaire__resume">
                  {nbVideos} {nbVideos > 1 ? 'vidéos' : 'vidéo'}, de la plus récente à la plus ancienne
                </span>
                <span class="sommaire__fleche" aria-hidden="true">→</span>
              </a>
            </li>
          )}
        </ul>
      </section>
    )
  }

  {
    nbVideos > 0 && (
      <section class="conteneur dernieres" aria-labelledby="dernieres-titre">
        <div class="dernieres__tete">
          <h2 class="titre-section" id="dernieres-titre">
            Dernières vidéos
          </h2>
          {nbVideos > 4 && (
            <a href={`/${build.slug}/${ADRESSE_VIDEOS}`} class="bouton">
              Toutes les vidéos →
            </a>
          )}
        </div>
        <div class="grille-videos">
          {build.videos.slice(0, 4).map((video) => (
            <CarteVideo video={video} />
          ))}
        </div>
      </section>
    )
  }

  {
    (prevues.length > 0 || (build.sousPages.length === 0 && nbVideos === 0)) && (
      <section class="conteneur chantier" aria-label="Sous-pages à venir">
        <div class="chantier__bloc">
          <p class="surtitre">Atelier en cours</p>
          <p class="chantier__texte">
            {prevues.length > 0 ? (
              <Fragment>
                Sous-pages en préparation : <strong>{prevues.join(' · ')}</strong>
              </Fragment>
            ) : (
              'D’autres contenus arrivent bientôt ici.'
            )}
          </p>
        </div>
      </section>
    )
  }
</Studio>

<style>
  .tete {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    align-items: end;
    gap: 40px 56px;
    padding-block: 96px 64px;
  }

  .tete__type {
    margin-bottom: 22px;
    color: var(--accent);
  }

  .tete__nom {
    margin: 0;
    font-family: var(--f-titre);
    font-weight: 900;
    font-size: clamp(60px, 9vw, 128px);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    color: var(--titre-build);
  }

  .tete__droite {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tete__resume {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--texte-doux);
  }

  .tete__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .visuel {
    margin-block: 0;
    padding-bottom: 96px;
  }

  .visuel__cadre {
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--noir-profond);
  }

  .visuel__cadre img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Vignettage léger et repères de cadrage aux quatre coins, à la couleur du build. */
  .visuel__cadre::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 120px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }

  .visuel__cadre::before {
    --repere: 24px;
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 1;
    background:
      linear-gradient(var(--accent) 0 0) left top / var(--repere) 2px,
      linear-gradient(var(--accent) 0 0) left top / 2px var(--repere),
      linear-gradient(var(--accent) 0 0) right top / var(--repere) 2px,
      linear-gradient(var(--accent) 0 0) right top / 2px var(--repere),
      linear-gradient(var(--accent) 0 0) left bottom / var(--repere) 2px,
      linear-gradient(var(--accent) 0 0) left bottom / 2px var(--repere),
      linear-gradient(var(--accent) 0 0) right bottom / var(--repere) 2px,
      linear-gradient(var(--accent) 0 0) right bottom / 2px var(--repere);
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .visuel__legende {
    margin-top: 12px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .sommaire,
  .dernieres,
  .chantier {
    padding-bottom: 96px;
  }

  .sommaire__tete {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 40px;
    margin-bottom: 16px;
  }

  .sommaire__liste {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sommaire__lien {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    gap: 10px 16px;
    height: 100%;
    padding: 28px;
    border: 1px solid rgb(255 255 255 / 0.12);
    color: var(--texte);
    text-decoration: none;
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }

  .sommaire__lien:hover {
    border-color: var(--accent);
    background: rgb(255 255 255 / 0.03);
  }

  .sommaire__nom {
    font-family: var(--f-titre);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--titre-build);
  }

  /* Trois lignes au plus : le texte complet est sur la sous-page. */
  .sommaire__resume {
    grid-column: 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 16px;
    color: var(--texte-doux);
  }

  .sommaire__fleche {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--f-mono);
    font-size: 18px;
    color: var(--accent);
    transition: transform 0.3s;
  }

  .sommaire__lien:hover .sommaire__fleche {
    transform: translateX(4px);
  }

  .dernieres__tete {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px 24px;
    margin-bottom: 32px;
  }

  .chantier__bloc {
    display: grid;
    gap: 12px;
    padding: 40px;
    border: 1px dashed rgb(255 255 255 / 0.16);
  }

  .chantier__texte {
    margin: 0;
    font-size: 18px;
    color: var(--texte-doux);
  }

  .chantier__texte strong {
    color: var(--texte);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .tete {
      padding-block: 56px 40px;
    }

    .tete__resume {
      font-size: 17px;
    }

    .visuel,
    .sommaire,
    .dernieres,
    .chantier {
      padding-bottom: 64px;
    }

    .visuel__cadre {
      aspect-ratio: 16 / 10;
    }

    .visuel__cadre::before {
      --repere: 16px;
      inset: 10px;
    }

    .sommaire__lien {
      padding: 22px;
    }

    .sommaire__nom {
      font-size: 28px;
    }

    .chantier__bloc {
      padding: 24px;
    }
  }
</style>
