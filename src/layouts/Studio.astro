---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import { lireStudio } from '../lib/contenu';

interface Props {
  titre: string;
  description: string;
  /** Couleurs d'un build : la page prend son ambiance, la barre du studio reste la même. */
  theme?: { fond: string; accent: string; titre: string };
  /** Aperçu affiché quand le lien est partagé (og:image), 1200 × 630. */
  image?: string;
}

const { titre, description, theme, image } = Astro.props;
// Les moteurs de recherche coupent vers 160 caractères : on coupe nous-mêmes, sur un mot entier.
const resume = description.length > 160 ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}…` : description;
const apercu = image && new URL(image, Astro.site ?? Astro.url).href;
// Adresse de référence, sans barre oblique finale comme les liens du site (le sitemap utilise la même).
const canonique = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site ?? Astro.url).href;
const studio = await lireStudio();
const style = theme
  ? `--fond: ${theme.fond}; --accent: ${theme.accent}; --titre-build: ${theme.titre};`
  : undefined;
---

<!doctype html>
<html lang="fr" style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={resume} />
    <meta name="theme-color" content="#050506" />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={resume} />
    <meta property="og:url" content={canonique} />
    {apercu && <meta property="og:image" content={apercu} />}
    {apercu && <meta property="og:image:width" content="1200" />}
    {apercu && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={apercu ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="sr-only lien-evitement" href="#contenu">Aller au contenu</a>
    <Entete github={studio.liens.github} />
    <main id="contenu">
      <slot />
    </main>
    <Pied liens={studio.liens} />
  </body>
</html>
