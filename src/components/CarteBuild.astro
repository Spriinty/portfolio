---
import Crayon from './Crayon.astro';
import Depuis from './Depuis.astro';
import Statut from './Statut.astro';
import type { Build } from '../lib/contenu';
import { imageDeCarte } from '../lib/images';

interface Props {
  build: Build;
}

const { build } = Astro.props;
const ou = build.liens.map((lien) => lien.libelle).join(' · ') || 'Bientôt en ligne';
// Les sous-pages déjà en ligne, sinon celles annoncées dans l'admin.
const pages =
  [...build.sousPages.map((page) => page.titre), ...(build.videos.length > 0 ? ['Vidéos'] : [])].join(' · ') ||
  build.pages ||
  '—';
const fond = await imageDeCarte(build.image);
---

<!-- Le lien du titre couvre toute la carte (::after) ; le crayon passe au-dessus. -->
<article class="carte" style={`--titre-build: ${build.couleurs.titre}`} data-carte>
  {fond && <img src={fond.src} alt="" class="carte__fond" loading="lazy" decoding="async" />}
  <div class="carte__haut">
    <span>Build {String(build.numero).padStart(2, '0')}</span>
    <span class="carte__etat">
      <Crayon chemin={`collection/builds/item/${build.slug}`} libelle={`Modifier ${build.nom}`} />
      <Statut choix={build.statut} derniereActivite={build.derniereActivite} />
    </span>
  </div>
  <h3 class="carte__nom">
    <a href={`/${build.slug}`} class="carte__lien">{build.nom}</a>
  </h3>
  <dl class="carte__fiche">
    <dt>Type</dt>
    <dd>{build.type || '—'}</dd>
    <dt>Où</dt>
    <dd>{ou}</dd>
    <dt>Pages</dt>
    <dd>{pages}</dd>
    <dt>Activité</dt>
    <dd><Depuis date={build.derniereActivite} /></dd>
  </dl>
</article>

<style>
  .carte {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 420px;
    padding: 24px;
    background: var(--carte);
    border: 1px solid var(--bord);
    color: var(--texte);
    text-decoration: none;
    transition:
      border-color 0.35s,
      box-shadow 0.35s;
  }

  .carte[hidden] {
    display: none;
  }

  .carte:hover {
    border-color: var(--accent);
    box-shadow: 0 18px 50px -20px rgb(255 90 54 / 0.45);
  }

  /* Image du projet en filigrane, en noir et blanc ; elle reprend ses couleurs au survol.
     Le dégradé du masque la fait disparaître vers le bas, derrière la fiche. */
  .carte__fond {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
    filter: grayscale(1);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 85%);
    transition:
      opacity 0.5s ease,
      filter 0.5s ease;
  }

  .carte:hover .carte__fond,
  .carte:focus-within .carte__fond {
    opacity: 0.42;
    filter: grayscale(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .carte,
    .carte__fond {
      transition: none;
    }
  }

  .carte__haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .carte__haut :global(.statut) {
    color: var(--texte);
  }

  .carte__etat {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .carte__lien {
    color: inherit;
    text-decoration: none;
  }

  .carte__lien::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .carte__lien:focus-visible {
    outline: none;
  }

  .carte:has(.carte__lien:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .carte__nom {
    flex-grow: 1;
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: 40px 0 28px;
    font-family: var(--f-titre);
    font-weight: 800;
    font-size: 46px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--titre-build);
  }

  .carte__fiche {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 10px 12px;
    margin: 0;
    padding-top: 18px;
    border-top: 1px dashed var(--pointille);
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 1.4;
  }

  .carte__fiche dt {
    color: var(--gris);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .carte__fiche dd {
    margin: 0;
  }

  @media (max-width: 767px) {
    .carte {
      min-height: 320px;
    }

    .carte__nom {
      padding-block: 32px 24px;
      font-size: 42px;
    }
  }
</style>
